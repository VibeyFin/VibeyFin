<?xml version="1.0" encoding="utf-8"?>
<!-- A PlayerView that draws the video on a TextureView. Unlike the default SurfaceView, which sits in its
     own layer behind the window, a TextureView is an ordinary view: it slides and fades with the screen
     it is on, so the app's own transitions work when the player is left. The cost is that it cannot pass
     HDR through; if that is wanted later, this is the one place to change. Controls are drawn in Compose. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="fit"
    app:surface_type="texture_view"
    app:use_controller="false" />
