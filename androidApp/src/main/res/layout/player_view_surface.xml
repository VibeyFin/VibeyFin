<?xml version="1.0" encoding="utf-8"?>
<!-- A PlayerView that draws the video on a SurfaceView, which is the only way HDR and Dolby Vision reach the
     display: a TextureView is composed like any other view and flattens them to SDR. The cost is that the
     SurfaceView sits in its own layer behind the window and does not slide or fade with the screen, so the
     player hides it before the screen is left (see PlayerScreen). SDR video keeps player_view_texture.xml.
     Controls are drawn in Compose. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="fit"
    app:surface_type="surface_view"
    app:use_controller="false" />
