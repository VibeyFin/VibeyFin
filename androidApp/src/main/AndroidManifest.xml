<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Offline mode follows the network, and downloads wait for Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Downloads go on with the screen off or the app closed, as a foreground service of the type "data sync" that WorkManager
         runs, with a progress notification (Android requires one, and docs/design/android.md asks for it). The permission to
         show the notification is asked for when the first download starts; without it the service still runs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Server discovery broadcasts on the local network and holds a multicast lock while it
         listens for answers. While targetSdk is 36 or lower, Android grants local network access
         with INTERNET. At targetSdk 37 it needs android.permission.ACCESS_LOCAL_NETWORK, declared
         here and requested at runtime, and that covers connecting to LAN servers too. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- New-title notifications, asked for when a profile switches Notifications on (Android 13 and up). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Backups are off: tokens live in a non-exportable Keystore key and can't be restored
         onto another device, so restored data would only produce unreadable tokens.
         Cleartext HTTP is allowed because most Jellyfin servers sit on a LAN at http://host:8096
         and the user types the address, so it can't be listed up front. -->
    <application
        android:name=".VibeyFinApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VibeyFin">

        <!-- WorkManager's own service, given the type Android 14 and later require of a foreground service. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- The activity handles rotation and window resizes itself, so turning the phone doesn't
             recreate it: the player would otherwise restart. Compose redraws on a configuration change. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
