root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = off
# Composables are named like types
ktlint_function_naming_ignore_when_annotated_with = Composable
# Files are named after the feature they hold, not after one of their declarations
ktlint_standard_filename = disabled
# Blank line before each declaration, so members and functions do not cluster
ktlint_standard_blank-line-before-declaration = enabled
